{
  "name": "ifp-apps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && tsx scripts/check-fixtures.ts",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:schema": "tsx scripts/export-content-schema.ts",
    "tauri": "tauri",
    "sync:mock": "node scripts/mock-sync-server.mjs",
    "server:dev": "tsx server/src/index.ts",
    "server:test": "vitest run server/src",
    "server:typecheck": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
