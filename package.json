{
  "name": "ifp-apps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run content:catalog",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run content:catalog",
    "content:catalog": "node scripts/build-content-catalog.mjs",
    "content:catalog:check": "node scripts/check-catalog-index.mjs",
    "content:review-sheet": "node scripts/generate-review-worksheet.mjs",
    "content:prereview": "node scripts/pedagogical-prereview.mjs",
    "content:quality-gap": "node scripts/analyze-content-quality.mjs",
    "content:asset-plan": "node scripts/generate-asset-plan.mjs",
    "content:review-binding": "tsx scripts/check-review-binding.ts",
    "content:review-sample": "tsx scripts/sample-approved-reviews.ts",
    "preview": "vite preview",
    "test": "vitest run && tsx scripts/check-fixtures.ts && node scripts/check-catalog-index.mjs && tsx scripts/check-review-binding.ts",
    "ci": "npm test && npm run server:typecheck && npm run server:test && npm run worker:typecheck && npm run build",
    "e2e": "node scripts/e2e/run.mjs smoke",
    "e2e:profile": "node scripts/e2e/run.mjs profile-lifecycle",
    "e2e:journey": "node scripts/e2e/run.mjs learning-journey",
    "e2e:rollback": "node scripts/e2e/run.mjs content-rollback",
    "e2e:license": "node scripts/e2e/run.mjs license",
    "e2e:license-online": "node scripts/e2e/run.mjs license-online",
    "e2e:home": "node scripts/e2e/run.mjs home-catalog",
    "e2e:activities": "node scripts/e2e/run.mjs activities",
    "e2e:backup": "node scripts/e2e/run.mjs backup-restore",
    "e2e:review": "node scripts/e2e/run.mjs content-review",
    "e2e:mode": "node scripts/e2e/run.mjs mode-switch",
    "e2e:player-fullscreen": "node scripts/e2e/run.mjs player-fullscreen",
    "e2e:deeplink": "node scripts/e2e/run.mjs player-deeplink",
    "e2e:quiz-coverage": "node scripts/e2e/run.mjs quiz-coverage",
    "a11y": "node scripts/e2e/run.mjs a11y",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:schema": "tsx scripts/export-content-schema.ts",
    "tauri": "tauri",
    "sync:mock": "node scripts/mock-sync-server.mjs",
    "server:dev": "tsx server/src/index.ts",
    "server:test": "vitest run server/src",
    "server:typecheck": "tsc -p tsconfig.server.json",
    "worker:typecheck": "tsc -p workers/api/tsconfig.json",
    "license:tool": "node scripts/license-issuer.mjs",
    "material:pack": "node scripts/material-pack.mjs",
    "catalog:mock": "node scripts/mock-catalog-server.mjs",
    "e2e:pinned": "node scripts/e2e/run.mjs pinned-materials",
    "e2e:material": "node scripts/e2e/run.mjs material-viewer",
    "e2e:material-import": "node scripts/e2e/run.mjs material-import",
    "e2e:material-pin": "node scripts/e2e/run.mjs material-pin",
    "e2e:material-catalog": "node scripts/e2e/run.mjs material-catalog",
    "e2e:studio": "node scripts/e2e/run.mjs material-studio",
    "catalog:dev": "node scripts/dev-catalog.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
