{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "type": "number",
      "const": 1
    },
    "packageId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "packageVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "gradeLevels": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6
      }
    },
    "subjects": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "curriculumRefs": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "framework": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "required": [
          "framework",
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/avif",
              "audio/mpeg",
              "audio/wav",
              "audio/ogg",
              "video/mp4",
              "video/webm",
              "application/json",
              "text/plain"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2147483648
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "mediaType",
          "sizeBytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "versionRange": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "packageId",
          "versionRange"
        ],
        "additionalProperties": false
      }
    },
    "signature": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "releaseState": {
      "type": "string",
      "enum": [
        "draft",
        "validated",
        "approved",
        "published",
        "withdrawn"
      ]
    }
  },
  "required": [
    "manifestVersion",
    "packageId",
    "packageVersion",
    "schemaVersion",
    "title",
    "locale",
    "gradeLevels",
    "subjects",
    "curriculumRefs",
    "assets",
    "dependencies",
    "signature"
  ],
  "additionalProperties": false
}
